server.port=8080
spring.db1.datasource.jdbcUrl=jdbc:postgresql://localhost:5432/product_db
spring.db1.datasource.username=postgres
spring.db1.datasource.password=Test
spring.datasource.primary.driver-class-name=org.postgresql.Driver

spring.db2.datasource.jdbcUrl=jdbc:mysql://localhost:3306/user_db
spring.db2.datasource.username=root
spring.db2.datasource.password=Test
spring.datasource.secondary.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update