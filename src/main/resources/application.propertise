server.port=8080

# PostgreSQL for Product Service
spring.datasource.product.url=jdbc:postgresql://localhost:5432/product_db
spring.datasource.product.username=postgres
spring.datasource.product.password=Test
spring.datasource.product.driver-class-name=org.postgresql.Driver

spring.jpa.product.hibernate.ddl-auto=update
spring.jpa.product.show-sql=true

# MySQL for User Service
spring.datasource.user.url=jdbc:mysql://localhost:3306/user_db
spring.datasource.user.username=root
spring.datasource.user.password=Test
spring.datasource.user.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.user.hibernate.ddl-auto=update
spring.jpa.user.show-sql=true
